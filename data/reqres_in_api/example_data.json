{
  "ROOTURL": "https://reqres.in",
  "test_cases": [
    {
      "name": "获取资源列表",
      "category": "resource",
      "method": " ",
      "url": "/api/resource",
      "body": null,
      "expected_status_code": 200,
      "expected_response": {
        "page": 1,
        "per_page": 6,
        "total": 12,
        "total_pages": 2,
        "data": [
          {
            "id": 1,
            "name": "cerulean",
            "year": 2000,
            "color": "#98B2D1",
            "pantone_value": "15-4020"
          },
          {
            "id": 2,
            "name": "fuchsia rose",
            "year": 2001,
            "color": "#C74375",
            "pantone_value": "17-2031"
          }
        ]
      }
    },
    {
      "name": "获取用户列表",
      "category": "user",
      "method": "GET",
      "url": "/api/users",
      "body": null,
      "expected_status_code": 200,
      "expected_response": {
        "page": 1,
        "per_page": 6,
        "total": 12,
        "total_pages": 2,
        "data": [
          {
            "id": 1,
            "email": "george.bluth@reqres.in",
            "first_name": "George",
            "last_name": "Bluth",
            "avatar": "https://reqres.in/img/faces/1-image.jpg"
          },
          {
            "id": 2,
            "email": "janet.weaver@reqres.in",
            "first_name": "Janet",
            "last_name": "Weaver",
            "avatar": "https://reqres.in/img/faces/2-image.jpg"
          }
        ]
      }
    },
    {
      "name": "获取特定用户",
      "category": "user",
      "method": "GET",
      "url": "/api/users/2",
      "body": null,
      "expected_status_code": 200,
      "expected_response": {
        "data": {
          "id": 2,
          "email": "janet.weaver@reqres.in",
          "first_name": "Janet",
          "last_name": "Weaver",
          "avatar": "https://reqres.in/img/faces/2-image.jpg"
        }
      }
    },
    {
      "name": "使用PUT更新用户",
      "category": "user",
      "method": "PUT",
      "url": "/api/users/2",
      "body": {
        "name": "John Doe",
        "job": "Software Engineer"
      },
      "expected_status_code": 200,
      "expected_response": {
        "name": "John Doe",
        "job": "Software Engineer",
        "updatedAt": "2023-10-01T12:34:56.789Z"
      }
    },
    {
      "name": "使用PATCH更新用户",
      "category": "user",
      "method": "PATCH",
      "url": "/api/users/2",
      "body": {
        "name": "Jane Doe",
        "job": "Product Manager"
      },
      "expected_status_code": 200,
      "expected_response": {
        "name": "Jane Doe",
        "job": "Product Manager",
        "updatedAt": "2023-10-01T12:34:56.789Z"
      }
    },
    {
      "name": "删除用户",
      "category": "user",
      "method": "DELETE",
      "url": "/api/users/2",
      "body": null,
      "expected_status_code": 204,
      "expected_response": null
    },
    {
      "name": "获取未知的资源",
      "category": "resource",
      "method": "GET",
      "url": "/api/resource/23",
      "body": null,
      "expected_status_code": 404,
      "expected_response": {}
    },
    {
      "name": "创建登录会话",
      "category": "login",
      "method": "POST",
      "url": "/api/login",
      "body": {
        "email": "eve.holt@reqres.in",
        "password": "cityslicka"
      },
      "expected_status_code": 200,
      "expected_response": {
        "token": "QpwL5tke4Pnpja7X4"
      }
    },
    {
      "name": "使用无效凭据登录",
      "category": "login",
      "method": "POST",
      "url": "/api/login",
      "body": {
        "email": "invalid.email@reqres.in",
        "password": "wrongpassword"
      },
      "expected_status_code": 400,
      "expected_response": {
        "error": "user not found"
      }
    },
    {
      "name": "注册一个新用户",
      "category": "registration",
      "method": "POST",
      "url": "/api/register",
      "body": {
        "email": "eve.holt@reqres.in",
        "password": "pistol"
      },
      "expected_status_code": 200,
      "expected_response": {
        "id": 4,
        "token": "QpwL5tke4Pnpja7X4"
      }
    },
    {
      "name": "密码缺失的注册",
      "category": "registration",
      "method": "POST",
      "url": "/api/register",
      "body": {
        "email": "eve.holt@reqres.in"
      },
      "expected_status_code": 400,
      "expected_response": {
        "error": "Missing password"
      }
    },
    {
      "name": "退出结束会话",
      "category": "logout",
      "method": "POST",
      "url": "/api/logout",
      "body": {},
      "expected_status_code": 200,
      "expected_response": {}
    }
  ]
}